# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
ANTHROPIC_API_KEY=sk-ant-...
# 사용할 Claude 모델과 사고 강도(low·medium·high·xhigh·max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
# 로컬 전용: 127.0.0.1 / 외부(휴대폰) 접속 단계에서만 0.0.0.0 으로 바꾸고 반드시 APP_PASSWORD 설정
APP_HOST=127.0.0.1
APP_PORT=8765
APP_PASSWORD=
# (선택) 구글지도 API 키 — 없어도 OpenStreetMap 지도와 '구글지도에서 열기' 링크는 동작
GOOGLE_MAPS_API_KEY=
